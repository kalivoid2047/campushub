# Backend
DATABASE_URL=postgresql+asyncpg://campushub:campushub@localhost:5432/campushub
REDIS_URL=redis://localhost:6379/0
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# Object storage (MinIO in dev, S3-compatible in prod)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=campushub-dev

# WebRTC — LiveKit (self-hosted, native install: infra/systemd/campushub-livekit.service)
LIVEKIT_URL=wss://livekit.localhost
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-to-a-random-32-byte-secret

# App
ENVIRONMENT=development
LOG_LEVEL=info

# Client
API_BASE_URL=http://localhost:8000
