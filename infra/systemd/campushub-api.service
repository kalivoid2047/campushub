# Native process deployment (no containers) — docs/13-deployment-guide.md.
[Unit]
Description=CampusHub FastAPI backend
After=network.target postgresql.service redis.service

[Service]
User=campushub
WorkingDirectory=/opt/campushub/backend
EnvironmentFile=/opt/campushub/.env
ExecStart=/opt/campushub/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 4
Restart=on-failure

[Install]
WantedBy=multi-user.target
